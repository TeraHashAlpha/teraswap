{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Edit(/.claude/settings*.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)"
    ],
    "deny": [
      "Bash(ssh)",
      "Bash(ssh *)",
      "Bash(scp)",
      "Bash(scp *)",
      "Bash(ssh-add)",
      "Bash(ssh-add *)",
      "Bash(pm2)",
      "Bash(pm2 *)",
      "Bash(cast send *)",
      "Bash(cast s *)",
      "Bash(security)",
      "Bash(security *)",
      "Bash(git credential*)",
      "Bash(git * credential*)",
      "Bash(git push *--force*)",
      "Bash(git * push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * push * +*)",
      "Bash(git push *:+*)",
      "Bash(git * push *:+*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr close*)",
      "Bash(gh * pr create*)",
      "Bash(gh * pr merge*)",
      "Bash(gh * pr ready*)",
      "Bash(gh * pr close*)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -f*)",
      "Bash(gh api * -F*)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "Bash(gh * api -X*)",
      "Bash(gh * api * -X*)",
      "Bash(gh * api --method*)",
      "Bash(gh * api * --method*)",
      "Bash(gh * api * -f*)",
      "Bash(gh * api * -F*)",
      "Bash(gh * api --field*)",
      "Bash(gh * api * --field*)",
      "Bash(gh * api --raw-field*)",
      "Bash(gh * api * --raw-field*)",
      "Bash(gh * api --input*)",
      "Bash(gh * api * --input*)",
      "Bash(npm audit fix*)",
      "Bash(npm audit *--fix*)",
      "Bash(history)",
      "Bash(history *)",
      "Read(.env*)",
      "Read(!.env.example)",
      "Edit(.env*)",
      "Edit(!.env.example)",
      "Read(~/.zsh_history)",
      "Read(~/.zhistory)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/.bash_history)",
      "Read(~/.sh_history)",
      "Read(~/.history)",
      "Read(~/.histfile)",
      "Read(~/.local/share/fish/fish_history)",
      "Read(~/.python_history)",
      "Read(~/.node_repl_history)",
      "Edit(~/.zsh_history)",
      "Edit(~/.bash_history)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/command-guard.mjs\" || exit 2",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/readonly-guard.mjs\" || exit 2",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
