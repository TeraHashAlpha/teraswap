# ══════════════════════════════════════════════════════════════
# TeraSwap — Environment Configuration Template
# ══════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# All NEXT_PUBLIC_ vars are exposed to the browser.
# Keys WITHOUT NEXT_PUBLIC_ are server-only (API routes only).
# ══════════════════════════════════════════════════════════════

# ── Chain ──────────────────────────────────────────────────────
# 1 = Ethereum mainnet, 11155111 = Sepolia testnet
CHAIN_ID=1

# ── RPC ───────────────────────────────────────────────────────
# Primary RPC — use Alchemy or Infura for production reliability
NEXT_PUBLIC_RPC_URL=https://eth.llamarpc.com

# Fallback RPCs — automatic failover when primary is down
NEXT_PUBLIC_FALLBACK_RPC_1=https://rpc.ankr.com/eth
NEXT_PUBLIC_FALLBACK_RPC_2=https://ethereum-rpc.publicnode.com

# ── Alchemy Enhanced API ──────────────────────────────────────
# Server-only. Required for Portfolio token discovery (getTokenBalances).
# Get free at https://dashboard.alchemy.com — 300M compute units/month on free tier.
# When unset, /api/portfolio/tokens returns 503 and the Portfolio tab falls
# back to the DEFAULT_TOKENS multicall path (Sprint 31 behaviour).
#
# [CHORE-POLISH-3 P4 / E3-I-02] APP SCOPE: this ONE key serves BOTH
# eth-mainnet AND base-mainnet (portfolio Base discovery, E-3). In the
# Alchemy dashboard the app must have both networks enabled — a key scoped
# to Ethereum mainnet only SILENTLY degrades Base discovery to 503 (the
# multicall fallback covers it, but with worse UX and no startup error).
ALCHEMY_API_KEY=

# ── Aggregator API Keys (server-only) ─────────────────────────
# These are NOT exposed to the browser. Only used in API routes.
# 1inch — get from https://portal.1inch.dev
ONEINCH_API_KEY=
# 0x — get from https://0x.org/docs
ZEROX_API_KEY=
# Odos — get from https://docs.odos.xyz/api/access
ODOS_API_KEY=
# Bebop (JAM aggregation) — server-only [ADR-010]. BEBOP_SOURCE is the partner id
# (query `source=`), BEBOP_API_KEY is the `source-auth` header. Without a key Bebop
# returns widened demo-mode quotes (dev only). NEVER use NEXT_PUBLIC_ for these.
# Our partner fee uses NEXT_PUBLIC_FEE_PERCENT (bps) → NEXT_PUBLIC_FEE_RECIPIENT below.
BEBOP_API_KEY=
BEBOP_SOURCE=

# ── WalletConnect ─────────────────────────────────────────────
# Get free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Fees ──────────────────────────────────────────────────────
# Your wallet address for fee collection (MUST be a real address, not zero)
NEXT_PUBLIC_FEE_RECIPIENT=
# Fee percentage (0.1 = 0.1%)
NEXT_PUBLIC_FEE_PERCENT=0.1
# FeeCollector V2 smart contract address (mainnet default baked into constants.ts:
# 0x47f24068932Ac49bcbeD3aD105af57C6ECDF7459). Override here for staging/forks.
NEXT_PUBLIC_FEE_COLLECTOR=

# ── Supabase (public — browser-safe) ─────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (server-only — API routes) ──────────────────────
# NEVER expose the service role key to the browser!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# [P114/M-03] Least-privilege key for fire-and-forget logging paths
# (swaps insert, quotes insert, security_events, wallet_activity,
# usage_events). Bound to logger_role via Supabase custom claim
# `role: logger_role`. Provision in Dashboard → Settings → API →
# Generate new key. If unset, supabase.ts falls back to the
# service-role key with a one-time warning — so production stays
# alive during the rollout window before the key exists.
SUPABASE_LOGGER_KEY=your-logger-role-key

# ── Order Engine ──────────────────────────────────────────────
# TeraSwapOrderExecutor contract address (set after deployment)
NEXT_PUBLIC_ORDER_EXECUTOR_ADDRESS=

# [SPRINT-V3-P2 / ADR-013] TeraSwapOrderExecutorV3 addresses — NOT deployed yet. Leave unset:
# unset/empty = v3 signing DISABLED on that chain (fail-closed, v2 flow untouched). Set ONLY
# after a real OrderExecutorV3 is deployed + verified on that chain.
NEXT_PUBLIC_ORDER_EXECUTOR_V3_ADDRESS=
NEXT_PUBLIC_ORDER_EXECUTOR_V3_ADDRESS_BASE=
NEXT_PUBLIC_ORDER_EXECUTOR_V3_ADDRESS_ARBITRUM=
# Keeper-side v3 executor address for the chain this keeper instance serves (CHAIN_ID). Unset =
# the keeper SKIPS + FLAGS any order that targets v3, never mis-routing it to v2.
ORDER_EXECUTOR_V3_ADDRESS=

# ── Admin ─────────────────────────────────────────────────────
# Wallet address for admin dashboard access
NEXT_PUBLIC_ADMIN_WALLET=

# Pepper used to derive the SHA-256 hash for admin API keys (per-key
# storage avoids ever persisting the plaintext). Generate via:
#   openssl rand -hex 32
# Rotation requires re-hashing every key in the KV admin index.
ADMIN_API_KEYS_SECRET=

# Bearer token gating POST /api/monitor/validate-execution. The
# executor pipeline submits validation requests with this header on
# every confirmed swap. Generate via: openssl rand -hex 32
EXECUTOR_VALIDATION_SECRET=

# Bearer token gating the read-only per-source quote diagnostic
# (GET /api/quote?...&debug=sources). Admin-only; reports each source's
# quote outcome on a given chainId. Unset → the debug branch returns 401
# (fails closed) and normal quoting is unaffected. Generate via: openssl rand -hex 32
DEBUG_QUOTE_TOKEN=

# ── Health Endpoint ───────────────────────────────────────────
# Token to protect /api/health from unauthorized access
HEALTH_TOKEN=

# ── Flashbots (optional) ─────────────────────────────────────
# MEV-protected transaction submission (mainnet only).
# UNUSED — candidate for removal. Verified by grepping src/ on
# 2026-05-27; no code currently reads this variable.
# FLASHBOTS_RPC_URL=https://rpc.flashbots.net

# ── Launch Countdown (optional) ───────────────────────────────
# Set to an ISO-8601 date to show a countdown before launch.
# Remove or leave empty to go live immediately.
# UNUSED — candidate for removal. Verified by grepping src/ on
# 2026-05-27; no code currently reads this variable.
# NEXT_PUBLIC_LAUNCH_DATE=2026-03-15T12:00:00Z

# ── Error Monitoring (Sentry) ─────────────────────────────────
# Get free at https://sentry.io → Create project (Next.js) → copy DSN
NEXT_PUBLIC_SENTRY_DSN=

# ── Vercel KV (Rate Limiting + Source State + Monitoring) ────
# Required for:
#   - Persistent rate limiting across serverless instances
#   - Source state machine (H1/H2 health monitoring)
#   - Monitor heartbeat (dead-man's switch)
# Create at: Vercel Dashboard → Storage → KV → Create
# If not set, rate limiting and monitoring fail open.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Monitoring Cron ──────────────────────────────────────────
# Shared secret between the Cloudflare Worker scheduler and /api/monitor/tick.
# Generate via: openssl rand -hex 32
# Must match the secret set on the Worker (wrangler secret put MONITOR_CRON_SECRET).
# Without this, /api/monitor/tick + heartbeat endpoints return 503 silently.
MONITOR_CRON_SECRET=

# Bearer token gating the operator-facing monitor admin endpoints
# (e.g. /api/monitor/status, /api/monitor/heartbeat/admin). Separate
# from MONITOR_CRON_SECRET so cron tokens can be rotated without
# locking out humans. Generate via: openssl rand -hex 32
MONITOR_SECRET=

# ── Monitoring Alerts ────────────────────────────────────────
# Alert channels for source state transitions. All optional — channels with
# missing env vars are silently skipped (graceful degradation).

# Telegram Bot API (primary channel)
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram webhook verification — random string passed to setWebhook.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Telegram admin IDs — comma-separated numeric user IDs for admin commands.
# Get your ID via @userinfobot. These users can run /disable, /activate, /grace.
TELEGRAM_ADMIN_IDS=

# Email via Resend (secondary channel)
# Sign up at https://resend.com, verify your domain
RESEND_API_KEY=
ALERT_EMAIL_TO=

# Discord webhook (tertiary channel)
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Grace period — suppress alerts during planned maintenance.
# Set to an ISO 8601 timestamp (e.g., 2026-04-16T02:00:00Z).
# Exception: kill-switch alerts ALWAYS fire regardless of grace.
# Also forces /api/monitor/heartbeat to report healthy (watchdog won't page).
# Leave empty for no grace period.
MONITOR_GRACE_UNTIL=

# ── Kill-Switch Authentication ───────────────────────────────
# Hardware-bound — store only on YubiKey-protected systems.
# Generate: openssl rand -base64 32
# This is a P0 credential — treat with extreme care.
# Used by POST /api/admin/kill-switch to force-disable sources.
KILL_SWITCH_SECRET=

# [DCA-OBS] Bearer secret for POST/GET /api/admin/dca-freeze — the admin-only path that
# toggles the DCA circuit-breaker (rejects NEW DCA orders; keeper skips DCA execution).
# User-safe: freeze NEVER cancels orders / touches funds / changes approvals (delay, not loss).
# If unset, the freeze-toggle route returns 503. The keeper + API fail-OPEN when the flag is
# unreadable; on-chain pause() is the nuclear escalation. A P0 credential.
DCA_FREEZE_SECRET=

# ── External Watchdog ────────────────────────────────────────
# GitHub Actions polls GET /api/monitor/heartbeat every 5 min.
# If the heartbeat is stale (>3 min), it sends an alert to this webhook.
# Set in GitHub repo Settings → Secrets → WATCHDOG_ALERT_WEBHOOK.
# Supports Telegram bot webhook or Discord webhook URL.
# WATCHDOG_ALERT_WEBHOOK= (GitHub Secret, not set here)

# ── Base L2 (Phase 2 — "Coming Soon" until FeeCollector deployed) ──────
# Base mainnet RPC (Alchemy/QuickNode recommended; public default used otherwise)
NEXT_PUBLIC_BASE_RPC_URL=
# FeeCollector address on Base — set ONLY after deployment (flips Base live)
NEXT_PUBLIC_BASE_FEE_COLLECTOR=

# ── Arbitrum One (SPRINT-47-ARBITRUM-ACTIVATION-PREP — dark until a real FeeCollector is
# deployed there; see docs/Runbooks/ARBITRUM-FEECOLLECTOR-DEPLOY.md) ──────
# [CHORE-ARBITRUM-ACTIVATION-SWITCH-PROOF] Leaving EITHER of the two vars below blank keeps
# Arbitrum DCA off (isDcaLive(42161) stays false) — both must be set to real deployed addresses to
# go live. WARNING: marking a NEXT_PUBLIC_* var "Sensitive" in Vercel prevents build-time inlining
# for these client-read vars — that failure mode presents identically to the chain just staying
# dark, with no error anywhere.
# Arbitrum One mainnet RPC (Alchemy/QuickNode recommended; public default used otherwise)
NEXT_PUBLIC_ARBITRUM_RPC_URL=
# FeeCollector address on Arbitrum — set ONLY after deployment (flips Arbitrum live, same
# env-driven pattern as Base). Unset ⇒ Arbitrum stays "Coming Soon" (isChainActive(42161) === false).
NEXT_PUBLIC_ARBITRUM_FEE_COLLECTOR=
# OrderExecutorV3 address on Arbitrum — set ONLY after deployment + verification. Unset ⇒
# getOrderExecutorV3(42161) stays null ⇒ isDcaLive(42161) stays false (fail-closed, same as v2).
NEXT_PUBLIC_ORDER_EXECUTOR_V3_ADDRESS_ARBITRUM=
